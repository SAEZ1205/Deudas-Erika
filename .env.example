VITE_LUCIA_API_URL=http://127.0.0.1:8787/api/lucia
LUCIA_PORT=8787
LUCIA_CALLS_PORT=8790

# LucIA / Gemini
GEMINI_API_KEY=PEGA_AQUI_TU_KEY
GEMINI_MODEL=gemini-2.5-flash

# DataEngine
# Local: http://127.0.0.1:8000
# Vercel: puede dejarse vacío; api/lucia.mjs usa el mismo deployment.
DATA_ENGINE_URL=
# true permite conservar la demo si los CSV raw no están disponibles en Vercel.
ALLOW_DEMO_FALLBACK=true

# Twilio (nunca colocar valores reales en GitHub)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADVISOR_PHONE=

# true = usa el flujo permitido por Twilio Trial (llamada real con plantilla Twilio)
# false = usa TwiML dinámico con el resumen del caso (cuenta sin la restricción del trial)
TWILIO_TRIAL_MODE=true
