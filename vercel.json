{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && node scripts/vercel-postbuild.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 30
    },
    "api/**/*.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/analysis/:customer_key/:subscriber_key",
      "destination": "/api/data_engine?customer_key=:customer_key&subscriber_key=:subscriber_key"
    },
    {
      "source": "/asesor",
      "destination": "/index.html"
    },
    {
      "source": "/asesor/:path*",
      "destination": "/index.html"
    }
  ]
}
